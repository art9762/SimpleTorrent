# Copy this file to .env or run: python3 scripts/setup.py
ST_PASSWORD=replace-with-a-private-password-at-least-12-characters
ST_SESSION_SECRET=replace-with-a-random-key-at-least-32-characters
ST_RPC_PASSWORD=replace-with-a-different-random-password
ST_PORT=8080
ST_BIND=0.0.0.0
ST_RESERVE_MIB=256
ST_SECURE_COOKIE=false
# Optional: absolute path to a mounted SSD. Create it and chown to 10001:10001.
# ST_STORAGE=/mnt/ssd/simpletorrent
